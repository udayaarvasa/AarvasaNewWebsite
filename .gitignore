# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local tooling (machine-specific paths)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# building models are served from the production model CDN, never from the
# public repository; a local copy under public/media is for development only
public/media/

# generated CDK deploy outputs (--outputs-file)
infra/cdk-outputs*.json

# Lambda packaging staging directory (see infra/scripts/bundle-processing.sh)
infra/dist-bundle/

# Migration runner packaging output (see infra/migration-runner/README.md)
infra/migration-runner/build/
