generator client {
  provider = "prisma-client-js"
  // The media processing Lambdas run on Node 24 / ARM64, so the client needs an
  // engine for that platform as well as the developer's own machine. Without
  // the second target the worker starts and then fails on its first query.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  AGENT
  BUILDER
  ADMIN
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  LAND
  STUDIO
  PENTHOUSE
  PLOT
  COMMERCIAL
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
  PENDING
}

enum RiskLevel {
  LOW
  MODERATE
  BALANCED
  HIGH
}

// Immersive media. Values mirror shared/media-asset.ts (checked by infra/test/media-asset.test.ts).

enum MediaSubjectType {
  PROPERTY // propertyId → Property.id
  PROJECT // projectSlug → a static project in src/lib/projects.ts (no table)
}

enum MediaAssetKind {
  MODEL
  PANORAMA
  SPLAT
  /// Flat video, played as video. Never spherical, never in the panorama viewer.
  VIDEO
}

enum MediaAssetFormat {
  GLB
  EQUIRECT_JPEG
  EQUIRECT_WEBP
  SOG
  MP4
}

/// How an asset was produced. Declared at upload, correctable at review, and
/// never inferred from the file: a render and a photograph are the same pixels
/// to a validator, and only a person knows which one they uploaded.
///
/// This also decides whether an asset may be shown to the public at all.
/// INTERNAL_TEST is the default precisely because it is the safe answer: an
/// asset whose provenance nobody stated is engineering material until someone
/// says otherwise, so a forgotten code path hides a test asset rather than
/// publishing it as a property's architecture.
/// Whether an asset may be resolved by public property browsing.
///
/// Separate from provenance on purpose. Provenance says what a thing is and
/// where it came from; visibility says whether the public may see it. Folding
/// the two together meant an asset could not be both honestly described as an
/// Aarvasa reconstruction and withheld from the public — the only way to keep it
/// private was to mislabel it as a test asset.
///
/// INTERNAL is the default, so an asset is withheld until someone decides
/// otherwise, and a forgotten code path hides media rather than publishing it.
enum MediaVisibility {
  /// Resolvable only through authorised internal preview.
  INTERNAL
  /// Resolvable by public property browsing.
  PUBLIC
}

enum MediaProvenance {
  /// Supplied by the developer as an official model of the building.
  OFFICIAL_MODEL
  /// Developer-produced render. Never described as a photograph.
  DEVELOPER_RENDER
  /// Photograph of a furnished demonstration unit, not a delivered residence.
  SHOW_APARTMENT_PHOTO
  /// Genuine equirectangular photograph.
  PHOTO_360
  /// Equirectangular frame rendered from a 3D model. Not a photograph.
  RENDERED_360
  /// Produced by Aarvasa's reconstruction pipeline from photos or video.
  AARVASA_RECONSTRUCTION
  /// Filmed on site during construction. Shows the site as filmed, not the finished building.
  SITE_FOOTAGE
  /// Engineering and QA only. Never public, in any environment.
  INTERNAL_TEST
}

/// One lifecycle: UPLOADED → PROCESSING → PENDING_REVIEW → PUBLISHED → ARCHIVED,
/// with FAILED (processing) and REJECTED (review) as terminal outcomes.
enum MediaAssetStatus {
  UPLOADED
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  FAILED
  ARCHIVED
}

// ─── Auth Models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  phone         String?
  bio           String?

  accounts     Account[]
  sessions     Session[]
  properties   Property[]
  entitlements Entitlement[]
  payments     Payment[]
  favorites    Favorite[]
  inquiries    Inquiry[]

  uploadedMediaAssets MediaAsset[] @relation("MediaAssetUploadedBy")
  reviewedMediaAssets MediaAsset[] @relation("MediaAssetReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Property Models ──────────────────────────────────────────────────────────

model Property {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  price        Float
  location     String
  city         String
  state        String
  country      String         @default("India")
  propertyType PropertyType   @default(APARTMENT)
  bedrooms     Int            @default(0)
  bathrooms    Int            @default(0)
  area         Float // sq ft
  roi          Float          @default(0)
  amenities    String[]
  images       String[] // Cloudinary URLs
  featured     Boolean        @default(false)
  verified     Boolean        @default(false)
  status       PropertyStatus @default(ACTIVE)
  riskLevel    RiskLevel      @default(MODERATE)

  // AI / Blockchain hooks (future)
  aiScore          Float?
  blockchainTxHash String?
  tokenized        Boolean @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  favorites Favorite[]
  inquiries Inquiry[]

  mediaAssets MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([city])
  @@index([propertyType])
  @@index([status])
  @@index([featured])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model Inquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String   @db.Text
  propertyId String
  userId     String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId])
}

// ─── Immersive Media ──────────────────────────────────────────────────────────

/// One publishable immersive-media asset (3D model, panorama or splat) for exactly
/// one subject: a Property row, or a static project identified by slug.
///
/// Stores object keys, never URLs: pages build URLs from the media CDN origin
/// (application configuration). Key layout is defined in shared/media-contract.ts.
///
/// Enforced by CHECK constraints in the add_media_asset migration (Prisma cannot
/// express them): exactly one subject matching subjectType; processed fields set
/// once PENDING_REVIEW/PUBLISHED; PUBLISHED has reviewedAt, publishedAt and altText;
/// REJECTED has rejectionReason; FAILED has processingError; keys are not URLs;
/// sizes are non-negative.
model MediaAsset {
  id String @id @default(cuid()) // also the {mediaId} segment of its object keys

  // Subject: exactly one of propertyId / projectSlug, matching subjectType.
  subjectType MediaSubjectType
  propertyId  String?
  projectSlug String?

  // Published asset. Null until processing succeeds.
  kind        MediaAssetKind
  format      MediaAssetFormat?
  status      MediaAssetStatus  @default(UPLOADED)
  storageKey  String? // version directory, e.g. m/{mediaId}/{hash16}
  entryFile   String? // file inside storageKey, e.g. scene.glb
  contentHash String? // SHA-256 hex of the entry file
  mimeType    String?
  sizeBytes   Int? // entry file bytes
  fileCount   Int? // published objects under storageKey (entry, textures, chunks)
  posterKey   String? // full object key, e.g. m/{mediaId}/{hash16}/poster.webp

  // Renderer metadata. Shapes: MediaAssetDimensions, MediaAssetMetrics and
  // MediaAssetViewDefaults in shared/media-asset.ts.
  dimensions   Json?
  metrics      Json?
  viewDefaults Json?

  title     String?
  altText   String?
  sortOrder Int     @default(0)

  /// Fail closed: an asset is engineering material until it says otherwise.
  provenance MediaProvenance @default(INTERNAL_TEST)

  /// Fail closed: withheld from public browsing until a reviewer releases it.
  visibility MediaVisibility @default(INTERNAL)

  // Uploaded original: an ingest key (uploads/…) or a private original (originals/…).
  sourceKey            String
  sourceSizeBytes      Int
  sourceMimeType       String
  // Canonical base64 SHA-256 declared at upload intent and enforced by S3; verified on
  // completion. Not contentHash, which is the processed entry file's hex SHA-256.
  sourceChecksumSha256 String?

  uploadedById     String?
  reviewedById     String?
  reviewedAt       DateTime?
  publishedAt      DateTime?
  rejectionReason  String?   @db.Text
  processingError  String?   @db.Text // internal diagnostic only; never shown to users
  processorVersion String? // e.g. 1.0.0/passthrough-v1

  // Processing lifecycle (Phase 5C, shared/media-processing.ts). failureCode is set
  // exactly when status is FAILED and maps to the only user-facing failure text.
  processingStartedAt      DateTime? // when the asset entered PROCESSING
  processingAttempts       Int       @default(0) // worker claims, capped by PROCESSING_POLICY.maxAttempts
  processingLeaseExpiresAt DateTime? // a worker holds the asset until then
  failureCode              String?

  // Deleting a Property that has media rows (any status) is refused rather than
  // cascading, so media records and their audit trail are never silently lost.
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  uploadedBy User?     @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("MediaAssetReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, status, sortOrder])
  @@index([projectSlug, status, sortOrder])
  // Public lookups filter on visibility and provenance as well as status, so both
  // are part of the key.
  @@index([projectSlug, status, visibility, provenance, sortOrder])
  @@index([status, createdAt])
  @@index([contentHash])
  @@index([uploadedById])
}

// ─── Entitlements ─────────────────────────────────────────────────────────────
//
// The commercial boundary. Public property discovery is free; creating and
// processing immersive media is not. Nothing here knows about a payment
// provider: Razorpay (or anything else) plugs in later behind the
// PaymentProvider interface in src/lib/entitlements/payment-provider.ts.
//
// Deliberately minimal. There is no Plan table, no Invoice, no Subscription —
// prices and packages are not defined yet, and speculative billing tables would
// be guesses. `planKey` is an opaque string until they are.

/// Only ACTIVE authorizes a premium capability. Every other value — including
/// the default — denies. See EntitlementService.check.
enum EntitlementStatus {
  INACTIVE
  ACTIVE
  EXPIRED
  SUSPENDED
}

/// Lifecycle of a payment attempt. No row is written until a real provider
/// reports one: there are no seeded or example payments.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

/// How an entitlement came to exist. Recorded because a test grant must be
/// distinguishable from a paid one for the rest of the system's life.
enum EntitlementSource {
  PAYMENT
  ADMIN_TEST
}

model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Opaque package identifier. Prices and plan definitions are deferred.
  planKey String

  /// Named capabilities this entitlement authorizes, validated server-side
  /// against ENTITLEMENT_CAPABILITIES. A string array rather than an enum so
  /// new capabilities do not each require a migration.
  capabilities String[]

  /// Defaults to INACTIVE: an entitlement row existing is never, by itself,
  /// permission.
  status EntitlementStatus @default(INACTIVE)

  activatedAt DateTime?
  /// Null means no expiry. A past value denies regardless of status.
  expiresAt   DateTime?
  suspendedAt DateTime?
  revokedAt   DateTime?

  source      EntitlementSource
  /// Admin who issued a test grant. Null for payment-derived entitlements.
  grantedById String?
  note        String?

  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Provider key, e.g. "razorpay". No provider-specific column lives here;
  /// provider payloads belong in the adapter, not the domain model.
  provider          String
  providerOrderId   String?
  providerPaymentId String? @unique
  /// Verification material. Only ever written after a server-side check of a
  /// provider webhook — never accepted from the browser.
  providerSignature String?

  /// Minor units (paise/fils) to avoid floating point on money.
  amountMinor Int?
  currency    String?

  status PaymentStatus @default(PENDING)

  entitlement Entitlement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
