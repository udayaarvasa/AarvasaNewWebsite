{
  "name": "aarvasa-media-infra",
  "version": "0.0.0",
  "private": true,
  "description": "Reviewable AWS CDK definitions for Aarvasa's immersive media platform (development environment only).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/infra/test/**/*.test.js\"",
    "synth": "npm run build && cdk synth --quiet",
    "plan": "npm run test && npm run synth && node dist/infra/scripts/plan-summary.js",
    "diff": "npm run build && cdk diff",
    "media:process": "tsc -p tsconfig.json && node dist/infra/src/pipeline/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "aws-cdk": "2.1141.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.269.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  }
}
