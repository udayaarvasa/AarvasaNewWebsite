{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "../shared/**/*.ts",
    "../src/lib/validations/media.ts",
    "../src/lib/media/ingest-storage.ts",
    "../src/lib/services/media-upload.service.ts",
    "../src/lib/services/media-completion.service.ts",
    "../src/lib/services/media-processing.store.ts",
    "../src/lib/services/media-review.service.ts",
    "../src/lib/media/processing-queue.ts",
    "../src/lib/media/published-storage.ts",
    "../src/lib/media/admin-upload-client.ts",
    "../src/lib/currency.ts",
    "../src/lib/project-types.ts",
    "../src/lib/projects.ts",
    "../src/lib/reef-projects.ts",
    "../src/lib/viewer/types.ts",
    "../src/lib/viewer/source.ts",
    "../src/lib/viewer/media-origin.ts",
    "../src/lib/viewer/panorama-math.ts",
    "../src/lib/viewer/load-gate.ts",
    "../src/lib/viewer/tour.ts",
    "../src/lib/viewer/analytics.ts",
    "../src/lib/viewer/panorama-fixtures.ts",
    "../src/lib/viewer/published-panoramas.ts",
    "../src/lib/viewer/project-tour.ts",
    "../src/lib/viewer/project-media.ts",
    "../src/lib/viewer/sog-bundle.ts",
    "../src/lib/viewer/splat-budget.ts",
    "../src/lib/viewer/splat-download.ts",
    "../src/lib/viewer/splat-fixtures.ts",
    "../src/lib/viewer/published-splats.ts",
    "../src/lib/viewer/project-splat.ts",
    "../src/lib/viewer/immersive-modes.ts",
    "../src/lib/viewer/render-demand.ts"
  ],
  "exclude": ["node_modules", "dist", "cdk.out"]
}
