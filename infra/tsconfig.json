{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "../shared/**/*.ts",
    "../src/lib/validations/media.ts",
    "../src/lib/media/ingest-storage.ts",
    "../src/lib/services/media-upload.service.ts",
    "../src/lib/services/media-completion.service.ts"
  ],
  "exclude": ["node_modules", "dist", "cdk.out"]
}
